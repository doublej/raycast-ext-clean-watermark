{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "clean-watermark",
  "title": "Clean Watermark",
  "description": "Remove watermarks, formatting, and junk from clipboard text",
  "icon": "command-icon.png",
  "author": "jurrejan",
  "categories": ["Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "clean-watermark",
      "title": "Clean Watermark",
      "description": "Clean clipboard text of watermarks and formatting",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^18.3.3",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build --skip-types -e dist -o dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
